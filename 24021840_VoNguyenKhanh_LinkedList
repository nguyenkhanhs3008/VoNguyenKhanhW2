        xoadau(head);
        return;
    }
    node *temp = head;
    for (int i = 1; i < k - 1 && temp->next != NULL; i++) {
        temp = temp->next;
    }
    if (temp->next == NULL) return;  
    node *nodeToDelete = temp->next;
    temp->next = temp->next->next;
    delete nodeToDelete;
}
// 7.Duyệt xuôi
void DuyetXuoi(node *head) {
    node *temp = head;
    while (temp != NULL) {
        cout << temp->data << " ";
        temp = temp->next;
    }
    cout << endl;
}
//8.Duyệt ngược
void duyetnguoc(node *head) {
    if (head == NULL) return;
    
    duyetnguoc(head->next); 
    cout << head->data << " ";
}
